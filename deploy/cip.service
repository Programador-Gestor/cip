# /etc/systemd/system/cip.service
[Unit]
Description=CIP - Gestao da CIP/COSIP (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=cip
Group=cip
WorkingDirectory=/opt/cip
EnvironmentFile=/etc/cip.env
# --preload: cria tabelas/admin uma única vez, antes de abrir os workers.
ExecStart=/opt/cip/venv/bin/gunicorn --preload --workers 2 --threads 4 --bind 127.0.0.1:5002 --access-logfile - app:app
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target

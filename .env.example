# ---------------------------------------------------------------------------
# CIP — variáveis de ambiente
# No servidor: /etc/cip.env (chmod 600, dono root). NUNCA versione o arquivo
# preenchido: ele contém a senha do banco e a chave de sessão.
# Formato: NOME=valor  (sem espaço antes ou depois do "=", sem aspas)
# ---------------------------------------------------------------------------

# Chave de sessão. Gere no próprio servidor com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
CIP_SECRET_KEY=troque_por_uma_chave_gerada_de_64_caracteres

# Banco de dados.
#   - Ausente ou sqlite:///...  -> SQLite (desenvolvimento local)
#   - postgresql://...          -> Supabase (produção)
# Produção: usuário dedicado cip_app no formato cip_app.<ref-do-projeto>,
# pooler na porta 6543. Senha SÓ alfanumérica (um "@" na senha quebra a URL).
DATABASE_URL=postgresql://cip_app.REF_DO_PROJETO:SENHA_ALFANUMERICA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Caminho do SQLite quando DATABASE_URL não estiver definida (opcional).
# CIP_DB_PATH=/caminho/cip.db

# 1 em produção (HTTPS). 0 em desenvolvimento local, sem certificado —
# senão o cookie de sessão não é enviado e o login não "gruda".
CIP_HTTPS=1

# Administrador inicial — usado SÓ quando a tabela de usuários está vazia.
# Depois do primeiro acesso e da troca de senha, APAGUE a linha da senha
# e reinicie o serviço.
CIP_ADMIN_EMAIL=admin@santoandre.sp.gov.br
CIP_ADMIN_SENHA_INICIAL=troque_no_servidor

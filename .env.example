# ---------------------------------------------------------------------------
# CIP — variáveis de ambiente
# No servidor: /etc/cip.env (chmod 600, dono root). NUNCA versione o arquivo
# preenchido. Formato: NOME=valor  (sem espaço perto do "=", sem aspas)
# ---------------------------------------------------------------------------

# Chave de sessão. Gere no próprio servidor com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
CIP_SECRET_KEY=troque_por_uma_chave_gerada_de_64_caracteres

# Banco: ausente -> SQLite local (instance/cip.db); postgresql://... -> Supabase.
# Produção: usuário cip_app.<ref>, pooler porta 6543, senha SÓ letras e números.
DATABASE_URL=postgresql://cip_app.REF_DO_PROJETO:SENHA_ALFANUMERICA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# 1 em produção (HTTPS). 0 em desenvolvimento local.
CIP_HTTPS=1

# Pasta temporária dos uploads e do Excel da análise (esvaziada a cada uso;
# só o usuário do sistema acessa). Nada fica guardado nela.
CIP_TMP=/var/lib/cip/tmp

# Tamanho máximo do arquivo da Enel, em MB.
CIP_MAX_MB=400

# Administrador inicial — usado SÓ quando não existe nenhum usuário.
CIP_ADMIN_EMAIL=admin@santoandre.sp.gov.br
# CIP_ADMIN_SENHA_INICIAL=apague_depois_do_primeiro_acesso
